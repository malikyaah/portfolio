<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Sport">
<meta name="theme-color" content="#0b0b0c">
<title>Sport</title>
<style>
:root{color-scheme:dark;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
*{box-sizing:border-box}body{margin:0;background:#0b0b0c;color:#f5f5f7}main{max-width:560px;margin:auto;padding:22px 16px 48px}
h1{margin:4px 0 4px;font-size:30px}.sub{color:#999;margin-bottom:20px}.card{background:#171719;border:1px solid #2a2a2e;border-radius:18px;padding:16px;margin:12px 0}
label{display:block;color:#aaa;font-size:13px;margin:0 0 6px}.field{margin-bottom:14px}input,textarea{width:100%;border:1px solid #343438;background:#222225;color:#fff;border-radius:12px;padding:13px;font-size:17px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}button{border:0;border-radius:13px;font-size:16px;font-weight:600;min-height:46px}
.chip{background:#29292d;color:#fff;padding:9px 13px}.primary{width:100%;background:#f5f5f7;color:#111;padding:14px}.secondary{width:100%;background:#29292d;color:#fff;padding:12px;margin-top:9px}
.status{text-align:center;min-height:22px;margin-top:10px;font-size:14px}.ok{color:#74db8d}.err{color:#ff7a7a}.recent{padding:10px 0;border-bottom:1px solid #29292d}.muted{color:#929298;font-size:13px;margin-top:3px}.hint{font-size:12px;color:#777;text-align:center;margin-top:18px}
@media(max-width:360px){.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<main>
<h1>Entraînement</h1><div class="sub">Ajoute une série en quelques secondes.</div>
<div class="card">
<div class="field"><label>Séance</label><div class="chips">
<button class="chip" type="button" data-session="Push">Push</button>
<button class="chip" type="button" data-session="Pull">Pull</button>
<button class="chip" type="button" data-session="Legs">Legs</button>
<button class="chip" type="button" data-session="Point faible">Point faible</button>
</div><input id="session" placeholder="Push"></div>
<div class="field"><label>Exercice</label><input id="exercise" list="exerciseList" placeholder="Développé couché"><datalist id="exerciseList"></datalist></div>
<div class="grid">
<div class="field"><label>Poids (kg)</label><input id="weight" type="number" inputmode="decimal" step="0.25"></div>
<div class="field"><label>Répétitions</label><input id="reps" type="number" inputmode="numeric"></div>
<div class="field"><label>Série</label><input id="setNumber" type="number" inputmode="numeric" min="1" value="1"></div>
<div class="field"><label>RPE</label><input id="rpe" type="number" inputmode="decimal" min="0" max="10" step="0.5" value="8"></div>
</div>
<div class="field"><label>Note (optionnelle)</label><textarea id="notes" rows="2"></textarea></div>
<button id="save" class="primary" type="button">Enregistrer la série</button>
<button id="newExercise" class="secondary" type="button">Nouvel exercice</button>
<div id="status" class="status"></div>
</div>
<div class="card"><label>Dernières séries</label><div id="recent" class="muted">Chargement…</div></div>
<div class="hint">Sur iPhone : Safari → Partager → Sur l’écran d’accueil</div>
</main>
<script>
(()=>{const ENDPOINT="https://pxyliiahkbvpcedqvbqp.supabase.co/functions/v1/log-workout";
const TOKEN="4QD7bJ5w2mK9Nf8xZp6Hs3Vc7Lt1Ry",$=id=>document.getElementById(id),
session=$("session"),exercise=$("exercise"),weight=$("weight"),reps=$("reps"),setNumber=$("setNumber"),rpe=$("rpe"),notes=$("notes"),status=$("status"),recent=$("recent"),exerciseList=$("exerciseList");
session.value=localStorage.getItem("last_session")||"";exercise.value=localStorage.getItem("last_exercise")||"";weight.value=localStorage.getItem("last_weight")||"";
let history=[];try{history=JSON.parse(localStorage.getItem("exercise_history")||"[]")}catch{}
function renderHistory(){exerciseList.innerHTML="";history.forEach(name=>{const o=document.createElement("option");o.value=name;exerciseList.appendChild(o)})}
renderHistory();
document.querySelectorAll("[data-session]").forEach(b=>b.addEventListener("click",()=>session.value=b.dataset.session));
async function loadRecent(){try{const r=await fetch(ENDPOINT+"?recent=1",{headers:{"x-workout-token":TOKEN}});if(!r.ok)throw 0;const j=await r.json();if(!j.data?.length){recent.textContent="Aucune série enregistrée.";return}recent.innerHTML="";j.data.forEach(row=>{const d=document.createElement("div");d.className="recent";const m=document.createElement("div");m.textContent=row.exercise+" — "+(row.weight_kg??"—")+" kg × "+(row.reps??"—");m.style.fontWeight="600";const s=document.createElement("div");s.className="muted";s.textContent=[row.session_name,"série "+row.set_number,row.rpe==null?null:"RPE "+row.rpe].filter(Boolean).join(" · ");d.append(m,s);recent.appendChild(d)})}catch{recent.textContent="Impossible de charger les dernières séries."}}
$("save").addEventListener("click",async()=>{const ex=exercise.value.trim();if(!ex){status.textContent="Indique un exercice.";status.className="status err";return}if(reps.value===""){status.textContent="Indique les répétitions.";status.className="status err";return}
const payload={session_name:session.value.trim(),exercise:ex,set_number:Number(setNumber.value||1),weight_kg:weight.value===""?null:Number(weight.value),reps:Number(reps.value),rpe:rpe.value===""?null:Number(rpe.value),notes:notes.value.trim()};
status.textContent="Enregistrement…";status.className="status";
try{const r=await fetch(ENDPOINT,{method:"POST",headers:{"Content-Type":"application/json","x-workout-token":TOKEN},body:JSON.stringify(payload)});const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||("HTTP "+r.status));
localStorage.setItem("last_session",payload.session_name);localStorage.setItem("last_exercise",payload.exercise);if(payload.weight_kg!=null)localStorage.setItem("last_weight",String(payload.weight_kg));
history=[payload.exercise,...history.filter(x=>x!==payload.exercise)].slice(0,40);localStorage.setItem("exercise_history",JSON.stringify(history));renderHistory();setNumber.value=String(Number(setNumber.value||1)+1);reps.value="";notes.value="";status.textContent="Série enregistrée ✓";status.className="status ok";loadRecent()
}catch(e){status.textContent="Erreur : "+e.message;status.className="status err"}});
$("newExercise").addEventListener("click",()=>{exercise.value="";weight.value="";reps.value="";setNumber.value="1";notes.value="";exercise.focus()});loadRecent()})();
</script>
</body></html>
